# Backend Configuration
# Rename this file to .env and set your Remove.bg API key before running the backend.
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Frontend URL (for CORS in production on Render)
# Local development: http://localhost:3000
# Production on Render: https://your-frontend-app.onrender.com
FRONTEND_URL=http://localhost:3000
